# Copy to .env and edit. Default setup is fully local (Ollama) with no API key.
LLM_PROVIDER=ollama            # ollama | gemini | anthropic
LLM_MODEL=llama3.2:3b          # gemini: e.g. gemini-3.5-flash-lite | anthropic: a Claude model name
OLLAMA_HOST=http://localhost:11434
GEMINI_API_KEY=                # only if LLM_PROVIDER=gemini (free: https://aistudio.google.com/apikey)
GEMINI_MAX_RETRIES=2           # retry transient Gemini failures before returning an error
GEMINI_FALLBACK_MODEL=         # optional, e.g. gemini-2.5-flash-lite when the primary is busy
ANTHROPIC_API_KEY=             # only if LLM_PROVIDER=anthropic

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MIN_SCORE=0.25                 # similarity below this = "not found in documents"

# Comma-separated extra browser origins allowed to call the API (cloud frontend URL).
RAG_CORS_ORIGINS=
# Required for the private multi-user API. Get these from Supabase Project Settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Folder auto-indexed once when the library is empty (unauthenticated demos). "" disables.
SEED_DIR=
