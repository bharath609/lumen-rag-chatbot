# Copy to .env and edit. Default setup is fully local (Ollama) with no API key.
LLM_PROVIDER=ollama            # ollama | gemini | anthropic
LLM_MODEL=llama3.2:3b          # gemini: e.g. gemini-3.8-flash | anthropic: a Claude model name
OLLAMA_HOST=http://localhost:11434
GEMINI_API_KEY=                # only if LLM_PROVIDER=gemini (free: https://aistudio.google.com/apikey)
ANTHROPIC_API_KEY=             # only if LLM_PROVIDER=anthropic

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local       # local | gemini | hf (hosted options need no torch)
HF_API_TOKEN=                  # only if EMBEDDING_PROVIDER=hf (free: https://huggingface.co/settings/tokens)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MIN_SCORE=0.25                 # similarity below this = "not found in documents"

# Trust layer: claim-level self-verification + suggested follow-ups (1 extra
# LLM call each). Set to 0 to disable either and save latency/cost.
VERIFY_ANSWERS=1
SUGGEST_FOLLOWUPS=1

# Comma-separated extra browser origins allowed to call the API (cloud frontend URL).
RAG_CORS_ORIGINS=
# Folder auto-indexed once when the library is empty (hosted demos). "" disables.
SEED_DIR=data/sample

# Chroma Cloud (persistent index that survives host restarts on free tiers).
# Create a free database at https://trychroma.com and fill all three values.
# When unset, the index lives locally in ./chroma_db.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
